# S3_ENDPOINT=nyc3.digitaloceanspaces.com
# S3_REGION=nyc3
# S3_REGION_PRIVATE= # only when the private bucket is in another region than the public one
# S3_ACCESS_KEY=DO00EXAMPLEKEY
# S3_SECRET_KEY=EXAMPLE_SECRET_KEY
# S3_BUCKET_NAME_PRIVATE=
# S3_BUCKET_NAME=

# =============================================================================
# GOOGLE CLOUD STORAGE (GCP)
# =============================================================================
# STORAGE_DRIVER=gcp
# GCS_CREDENTIALS_FILE=/path/to/credentials.json
# GCS_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GCS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n
# S3_BUCKET_NAME_PRIVATE=
# S3_BUCKET_NAME=


################### Performance Configuration ###################
PERFORMANCE_MODE=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

################### Slack Configuration ###################
SLACK_ENABLE=false
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_NOTIFICATION_TTL=24h

################### TUF Configuration ###################

TUF_ENABLED=true
ONLINE_KEY_DIR=/private_keys

################### Reports Configuration ###################
# Report detail blobs may contain sensitive data, so they are stored in the
# private bucket (S3_BUCKET_NAME_PRIVATE) and served only via presigned URLs.

REPORTS_ENABLED=false
REPORTS_MAX_BODY_BYTES=262144
REPORTS_MAX_DETAILS_COMPRESSED_BYTES=131072
REPORTS_MAX_DETAILS_DECOMPRESSED_BYTES=1048576
REPORTS_BLOB_RETENTION_DAYS=30 # applied per blob at insert time, not by the Mongo TTL index
REPORTS_MAX_BLOBS_PER_GROUP=10
REPORTS_STORAGE_PREFIX=reports
REPORTS_RATE_LIMIT_PER_KEY_PER_MINUTE=100 # per-group 30/min and per-device+group 1/hour are fixed

# Selling licenses (see README, "Selling licenses"). The signing key is a
# 32-byte Ed25519 seed in hex; deploy/server-setup.sh makes one. Without it no
# license can be issued.
LICENSE_SIGNING_KEY=
# Where the store page lives, for order links and license emails.
STORE_URL=https://store.example.com
# Whom buyers write to about plans and licenses.
PLANS_CONTACT=sales@example.com

# Orders paid by bank transfer through SePay (sepay.vn). Orders are taken only
# when ORDERS_ENABLED is true, the signing key is set and the bank account is
# configured. The webhook is verified by HMAC (SEPAY_WEBHOOK_SECRET, preferred)
# or by the Apikey header; SEPAY_API_KEY reads the transaction list for
# `order reconcile`.
ORDERS_ENABLED=false
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_APIKEY=
SEPAY_API_KEY=

# Email for license keys, optional: without SMTP_HOST the order page is the
# only delivery. Port 465 means implicit TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Store <store@example.com>
